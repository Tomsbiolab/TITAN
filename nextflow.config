// nextflow.config

// Enable Docker
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

// Eager cleanup of intermediate work files to minimise peak disk usage.
// Nextflow deletes each task's work files as soon as every downstream task
// that needs them has finished (and after they have been copied to their
// publishDir, when one is defined). This keeps the big intermediates
// (.sra, .fastq, *_trim.fq.gz, *.Aligned.out.bam, *.filtered.bam, *.merged.bam)
// from all accumulating at once.
// NOTE: this is incompatible with `-resume`; a failed/interrupted run will
// re-execute tasks whose intermediates have already been deleted.
cleanup = 'eager'

// Default Parameters
params {
    has_prefetch    = (System.getenv("PATH")?.split(File.pathSeparator)?.any { new File(it, "prefetch").exists() } ?: false) &&
                      (System.getenv("PATH")?.split(File.pathSeparator)?.any { new File(it, "fastq-dump").exists() } ?: false)

    // Genomes
    genome          = "/media/hard_drive2/PN40024_data/T2T_ref.fasta"
    masked_genome   = "/media/hard_drive2/PN40024_data/T2T_ref_masked.fa"  // Leave empty to auto-run EDTA; or provide a path to skip EDTA
    
    // Evidences (Optional / Flexible inputs)
    ab_initio       = "/media/hard_drive2/PN40024_data/ab_initio/v4.3_from_40X_ref_on_T2T_ref_aegis_fcounts_dapfit.gff3"
    transcriptome   = "" // Can be empty if using SRA/FASTQ
    
    // New Transcriptomic Raw Inputs (Leave empty "" to ignore)
    sra_list        = ["/media/hard_drive2/PN40024_data/run_selection.csv", "/media/hard_drive2/PN40024_data/run_selection_2.csv"]   // e.g., "SRP019504.csv" or a list of SRA IDs (one per line)
    fastq_dir       = "/media/hard_drive1/PN40024_Illumina_samples"   // e.g., "/media/hard_drive2/fastq_files"

    // Long-read Transcriptomic Inputs (Leave empty "" to ignore)
    lr_sra_list     = ""   // e.g., "long_reads.csv" — same CSV format as sra_list
    lr_fastq_dir    = "/media/hard_drive2/PN40024_data/isoseq_PN40024"   // e.g., "/path/to/long_read_fastqs" (*.{fastq,fq,fasta,fa}*)

    // Databases
    fasta_databases_dir = "/media/hard_drive2/PN40024_data/fasta_databases"
    source_priority = "Araport11,Viridiplantae,Eudicotyledons"
    
    version         = "Nextflow_T2Tv5.2_TITAN"
    outdir          = "results"
    threads         = 60
}

// Process-specific Docker containers
process {
    withName: 'SRA_DOWNLOAD' {
        container = params.has_prefetch ? false : 'pegi3s/sratoolkit:3.1.0'
    }
    withName: 'FASTP' {
        container = 'antsanpaj/fastp:0.23.4'
        cpus = 4
    }
    withName: 'STAR_INDEX|STAR_ALIGN' {
        container = 'antsanpaj/star'
        cpus = params.threads
        // Retry only on exit 104 (truncated stream = Docker volume flush lag)
        // Other exit codes (e.g. bad params) will not retry.
        errorStrategy = { task.exitStatus == 104 ? 'retry' : 'finish' }
        maxRetries = 3
    }
    withName: 'PROCESS_BAM|MERGE_SORT_INDEX_BAM' {
        container = 'antsanpaj/samtools:1.17'
        cpus = 8
    }
    withName: 'ASSEMBLE_STRINGTIE' {
        container = 'antsanpaj/stringtie'
        cpus = 8
    }
    withName: 'ASSEMBLE_PSICLASS' {
        container = 'antsanpaj/psiclass:1.0.3'
        cpus = 8
    }
    withName: 'SRA_DOWNLOAD_LONG_READS' {
        container = params.has_prefetch ? false : 'pegi3s/sratoolkit:3.1.0'
    }
    withName: 'MINIMAP2_ALIGN' {
        container = 'antsanpaj/minimap2'
        cpus = params.threads
    }
    withName: 'SORT_BAM_LONG_READS|MERGE_SORT_INDEX_BAM_LONG_READS' {
        container = 'antsanpaj/samtools:1.17'
        cpus = 8
    }
    withName: 'ASSEMBLE_STRINGTIE_LONG_READS' {
        container = 'antsanpaj/stringtie'
        cpus = 8
    }
    withName: 'AEGIS_MERGE_ANNOTATIONS|AEGIS_FILTER_REDUNDANCY' {
        container = 'tomsbiolab/aegis:v0.3.9'
    }
    withName: 'DEDUP_PROTEINS|MERGE_PROTEINS_FOR_BRAKER' {
        container = 'staphb/seqkit:2.8.2'
    }
    withName: 'RUN_DIAMOND|MAKE_DIAMOND_DB' {
        container = 'antsanpaj/diamond:2.1.8'
        cpus = params.threads
    }
    withName: 'RUN_BRAKER' {
        container = 'teambraker/braker3:v3.0.7.5'
        cpus = params.threads
    }
    withName: 'RUN_EDTA' {
        container = 'antsanpaj/edta'
        cpus = params.threads
    }
}
